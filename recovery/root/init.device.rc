on init
    insmod /vendor/lib/modules/adaptive-ts.ko
    insmod /vendor/lib/modules/focaltech_ft3683g.ko
    insmod /vendor/lib/modules/gt9916_common.ko

# --- X6850: haptics + OTG ---------------------------------------------------
# NOTE: do NOT insmod the TW_LOAD_VENDOR_MODULES set here. If init loads them
# first, the OrangeFox kernel module loader counts 0 modules loaded and wrongly
# assumes touch is broken, popping the "Hardware GUI control" offer on every
# boot. The loader (TW_LOAD_VENDOR_MODULES) handles these, dependency-ordered.

# Everything that needs sysfs nodes or a mounted /data runs in this oneshot
# service (it sleeps while waiting, so init is never blocked). Started from
# "on post-fs-data", which is guaranteed to fire in the TWRP ramdisk.
service of_hw_init /system/bin/sh /system/bin/of_hw_init
    class main
    user root
    group root system shell
    oneshot
    seclabel u:r:recovery:s0

on post-fs-data
    start of_hw_init

# Block-device symlinks (by-name) are up by "on fs"; clear any stale
# boot-fastboot BCB before the recovery binary reads misc.
on fs
    exec - -- /bin/sh /system/bin/of_clear_bcb

# Leaving recovery to Android: drop OTG host role so normal charging works again.
on property:sys.usb.config=adb
    exec - -- /bin/sh -c "n=/sys/devices/platform/odm/odm:tran_battery/OTG_CTL; [ -e $n ] && echo 0 > $n; true"
