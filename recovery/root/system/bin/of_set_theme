#!/sbin/sh
# OrangeFox default theme for X6850 (erikshelby): Black + Red.
#
# TWRP reads the active theme from <Fox_Settings_Path>/.theme/{style,accent}.xml
# and only falls back to /twres/themes/*.xml when those are missing. Seeding
# them makes Black+Red the default, without ever overwriting a saved choice.

THEME_DIR=/data/media/0/Fox/.theme
SRC=/twres/themes

[ -d /data/media/0/Fox ] || mkdir -p /data/media/0/Fox
mkdir -p "$THEME_DIR"

# Style: Black (dark background, light text).
if [ ! -f "$THEME_DIR/style.xml" ] && [ -f "$SRC/styles/Black.xml" ]; then
	cp -f "$SRC/styles/Black.xml" "$THEME_DIR/style.xml"
fi

# Accent: red. The sed template uses #COLOR_LIGHT# for the main tint.
if [ ! -f "$THEME_DIR/accent.xml" ] && [ -f "$SRC/sed/accent.xml" ]; then
	sed -e 's/#ACCENT_NAME#/Red/g' \
	    -e 's/#COLOR_LIGHT#/#E53935/g' \
	    -e 's/#COLOR_DARK#/#E53935/g' \
	    -e 's/#COLOR#/#E53935/g' \
	    "$SRC/sed/accent.xml" > "$THEME_DIR/accent.xml"
fi

chmod 0660 "$THEME_DIR"/*.xml 2>/dev/null
chown media_rw:media_rw "$THEME_DIR"/*.xml 2>/dev/null || chown 1023:1023 "$THEME_DIR"/*.xml 2>/dev/null
restorecon -R "$THEME_DIR" 2>/dev/null

exit 0
