diff --git a/twrp-functions.cpp b/twrp-functions.cpp
index 36e0754..93a8af9 100755
--- a/twrp-functions.cpp
+++ b/twrp-functions.cpp
@@ -1146,6 +1146,15 @@ int TWFunc::tw_reboot(RebootCommand command)
 		case rb_recovery:
       			if (DoDeactivate == 1) { Deactivation_Process(); } 
 			check_and_run_script("/system/bin/rebootrecovery.sh", "reboot recovery");
+			// X6850 (mt6789): the bootloader ignores both the "recovery"
+			// reboot reason and the BCB "boot-recovery" command, so a real
+			// reboot always lands in the system. Restart the recovery
+			// process in place instead - same result the user expects.
+			sync();
+			gui_print("Restarting recovery...\n");
+			sleep(1);
+			execl("/system/bin/recovery", "recovery", (char *) NULL);
+			_exit(127);
 			return property_set(ANDROID_RB_PROPERTY, "reboot,recovery");
 		case rb_bootloader:
 			check_and_run_script("/system/bin/rebootbootloader.sh", "reboot bootloader");
